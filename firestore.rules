rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == 'ahmedhassan.work2020@gmail.com';
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isOwnerEmail());
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Memberships collection ({groupId}_{userId})
    match /memberships/{membershipId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Matches collection
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Reservations collection ({matchId}_{userId})
    match /reservations/{reservationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
